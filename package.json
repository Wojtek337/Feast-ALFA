{
  "name": "feast",
  "productName": "Feast",
  "version": "1.0.0",
  "description": "Feast: platforma dystrybucji gier",
  "author": "Feast",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.feast.desktop",
    "productName": "Feast",
    "files": ["main.js", "preload.js", "index.html", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": ["portable", "nsis"] },
    "portable": { "artifactName": "Feast-${version}-portable.exe" },
    "nsis": {
      "artifactName": "Feast-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
